# Configuración del servidor Backend (sin valores secretos reales)
PORT=3000
NODE_ENV=development

# Ruta local de la base de datos SQLite
DB_PATH=./data/lunar_missions.sqlite

# Origen permitido por CORS para el Frontend (Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Endpoint público oficial de efemérides NASA/JPL Horizons (no requiere API key)
NASA_HORIZONS_API_URL=https://ssd.jpl.nasa.gov/api/horizons.api
