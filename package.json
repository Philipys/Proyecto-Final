{
  "name": "artemis-lunar-navigator",
  "version": "0.1.0",
  "private": true,
  "description": "Evaluador de sitios de alunizaje, simulador energético lunar 2027 y visor 3D con datos reales de NASA JPL Horizons y LOLA DEM.",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "data:download": "tsx src/services/downloadNasaData.ts"
  },
  "keywords": [
    "nasa",
    "lunar",
    "artemis",
    "horizons",
    "lola",
    "threejs",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.15.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.0"
  }
}
